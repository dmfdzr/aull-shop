generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AdminRole {
  ADMIN
}

enum PoBatchStatus {
  DRAFT
  OPEN
  CLOSED
  ORDERED
  COMPLETED
}

enum OrderStatus {
  SUBMITTED
  CONFIRMED
  PO_CLOSED
  ORDERED_TO_SOURCE
  READY_FOR_SHOPEE
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  WAITING_DP
  DP_SUBMITTED
  DP_VERIFIED
  WAITING_FINAL_PAYMENT
  FINAL_SUBMITTED
  PAID
  REJECTED
}

enum ShipmentStatus {
  NOT_STARTED
  ORDERED_TO_SOURCE
  TO_OVERSEAS_WAREHOUSE
  AT_OVERSEAS_WAREHOUSE
  TO_INDONESIA_WAREHOUSE
  AT_INDONESIA_WAREHOUSE
  TO_JOGJA
  AT_JOGJA
  SHOPEE_CHECKOUT_PENDING
  FINAL_DELIVERY
  DELIVERED
}

enum PaymentType {
  DP
  FINAL
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum ShipmentStage {
  ORDERED_TO_SOURCE
  TO_OVERSEAS_WAREHOUSE
  AT_OVERSEAS_WAREHOUSE
  TO_INDONESIA_WAREHOUSE
  AT_INDONESIA_WAREHOUSE
  TO_JOGJA
  AT_JOGJA
  SHOPEE_CHECKOUT_PENDING
  FINAL_DELIVERY
  DELIVERED
}

model AdminProfile {
  id                String           @id @default(uuid()) @db.Uuid
  authUserId        String           @unique
  email             String           @unique
  name              String?
  role              AdminRole        @default(ADMIN)
  verifiedPayments  Payment[]        @relation("PaymentVerifier")
  shipmentEvents    ShipmentEvent[]  @relation("ShipmentEventCreator")
  verifiedCheckouts ShopeeCheckout[] @relation("ShopeeCheckoutVerifier")
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([email])
}

model PoBatch {
  id            String        @id @default(uuid()) @db.Uuid
  name          String
  description   String?
  sourceCountry String?
  openAt        DateTime?
  closeAt       DateTime?
  status        PoBatchStatus @default(DRAFT)
  products      Product[]
  orders        Order[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status])
  @@index([openAt, closeAt])
}

model Product {
  id             String           @id @default(uuid()) @db.Uuid
  batchId        String           @db.Uuid
  batch          PoBatch          @relation(fields: [batchId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  sourceCountry  String?
  sourceUrl      String?
  estimatedPrice Decimal          @db.Decimal(12, 2)
  minimumDp      Decimal          @db.Decimal(12, 2)
  imagePath      String?
  isActive       Boolean          @default(true)
  variants       ProductVariant[]
  orderItems     OrderItem[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([batchId])
  @@index([isActive])
}

model ProductVariant {
  id              String      @id @default(uuid()) @db.Uuid
  productId       String      @db.Uuid
  product         Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  label           String
  sku             String?
  priceOverride   Decimal?    @db.Decimal(12, 2)
  priceAdjustment Decimal?    @db.Decimal(12, 2)
  quota           Int?
  isActive        Boolean     @default(true)
  orderItems      OrderItem[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([productId])
  @@index([isActive])
}

model Customer {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  whatsapp  String
  email     String?
  address   String?
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([whatsapp])
}

model Order {
  id             String          @id @default(uuid()) @db.Uuid
  orderCode      String          @unique
  customerId     String          @db.Uuid
  customer       Customer        @relation(fields: [customerId], references: [id])
  batchId        String          @db.Uuid
  batch          PoBatch         @relation(fields: [batchId], references: [id])
  estimatedTotal Decimal         @db.Decimal(12, 2)
  dpTotal        Decimal         @db.Decimal(12, 2)
  notes          String?
  orderStatus    OrderStatus     @default(SUBMITTED)
  paymentStatus  PaymentStatus   @default(WAITING_DP)
  shipmentStatus ShipmentStatus  @default(NOT_STARTED)
  items          OrderItem[]
  payments       Payment[]
  shipmentEvents ShipmentEvent[]
  shopeeCheckout ShopeeCheckout?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([batchId])
  @@index([customerId])
  @@index([orderStatus])
  @@index([paymentStatus])
  @@index([shipmentStatus])
  @@index([createdAt])
}

model OrderItem {
  id                   String         @id @default(uuid()) @db.Uuid
  orderId              String         @db.Uuid
  order                Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId            String         @db.Uuid
  product              Product        @relation(fields: [productId], references: [id])
  variantId            String         @db.Uuid
  variant              ProductVariant @relation(fields: [variantId], references: [id])
  productNameSnapshot  String
  variantLabelSnapshot String
  quantity             Int
  unitPriceSnapshot    Decimal        @db.Decimal(12, 2)
  subtotal             Decimal        @db.Decimal(12, 2)
  createdAt            DateTime       @default(now())

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model Payment {
  id                 String             @id @default(uuid()) @db.Uuid
  orderId            String             @db.Uuid
  order              Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type               PaymentType
  amount             Decimal            @db.Decimal(12, 2)
  proofPath          String
  verificationStatus VerificationStatus @default(PENDING)
  verifiedByAdminId  String?            @db.Uuid
  verifiedByAdmin    AdminProfile?      @relation("PaymentVerifier", fields: [verifiedByAdminId], references: [id])
  verifiedAt         DateTime?
  rejectionReason    String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([orderId])
  @@index([type])
  @@index([verificationStatus])
}

model ShipmentEvent {
  id               String        @id @default(uuid()) @db.Uuid
  orderId          String        @db.Uuid
  order            Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  stage            ShipmentStage
  location         String?
  trackingNumber   String?
  notes            String?
  eventAt          DateTime
  createdByAdminId String?       @db.Uuid
  createdByAdmin   AdminProfile? @relation("ShipmentEventCreator", fields: [createdByAdminId], references: [id])
  createdAt        DateTime      @default(now())

  @@index([orderId])
  @@index([stage])
  @@index([eventAt])
}

model ShopeeCheckout {
  id                  String             @id @default(uuid()) @db.Uuid
  orderId             String             @unique @db.Uuid
  order               Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  instructionText     String?
  instructionUrl      String?
  customerInvoiceUrl  String?
  customerProofPath   String?
  verificationStatus  VerificationStatus @default(PENDING)
  finalTrackingNumber String?
  verifiedByAdminId   String?            @db.Uuid
  verifiedByAdmin     AdminProfile?      @relation("ShopeeCheckoutVerifier", fields: [verifiedByAdminId], references: [id])
  verifiedAt          DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([verificationStatus])
}
